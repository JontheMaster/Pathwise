{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pathwise-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-hostname",
        "127.0.0.1",
        "--web-port",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "pathwise-admin",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "-t",
        "lib/admin/main.dart",
        "--web-hostname",
        "127.0.0.1",
        "--web-port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
